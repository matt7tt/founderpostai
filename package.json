    "axios": "1.20.0",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "14.14.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
