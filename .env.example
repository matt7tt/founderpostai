# Database
DATABASE_URL="file:./dev.db"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_webhook_secret_here"
# Stripe Payment Links (dashboard → Products → Create payment link, no code needed)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO="https://buy.stripe.com/..."
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_AGENCY="https://buy.stripe.com/..."
# The recurring Price IDs attached to those two links
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."
STRIPE_PLUGIN_PORTAL_CONFIG="bpc_..."
NEXT_PUBLIC_STRIPE_BILLING_PORTAL="https://billing.stripe.com/p/login/..."

# Anthropic Claude
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="your_supported_model_id"

# AI Suite gateway storage and BYOK encryption
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
# Generate with: openssl rand -hex 32
GATEWAY_KMS_KEY="your_random_64_character_hex_key"

# Optional read-only Google Search Console connection. Configure a Google OAuth
# web client and register the exact callback URL shown here as an authorized
# redirect URI in Google Cloud Console.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="https://founderpostai.com/api/gateway/v1/search-console/callback"

# Private plugin-feedback inbox at /feedback-review.
# Use a unique password of at least 12 characters. The session uses
# FEEDBACK_ADMIN_SESSION_SECRET, NEXTAUTH_SECRET, or GATEWAY_KMS_KEY (in that
# order) as its signing secret.
FEEDBACK_ADMIN_PASSWORD="your_unique_admin_password"
FEEDBACK_ADMIN_SESSION_SECRET=""

# Auth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Public URL for redirects
NEXT_PUBLIC_URL="http://localhost:3000"

# Search engine ownership verification
# Paste the content value only, not the complete meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
